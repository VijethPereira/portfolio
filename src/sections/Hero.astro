---
import { Image } from "astro:assets";
import vijeth from "../assets/vijeth.jpg";
---

<section
  id="hero"
  class="relative px-6"
  style="max-width:1152px; margin:0 auto; padding-top:clamp(48px,8vw,96px); padding-bottom:clamp(48px,6vw,72px); display:flex; flex-wrap:wrap; gap:clamp(32px,5vw,64px); align-items:center;"
  id="hero-section"
>

  <!-- Left: Text content -->
  <div style="flex:1 1 480px; min-width:0;">

    <!-- PA20 tag -->
    <div class="js-reveal" style="--delay:0ms">
      <p class="font-display font-semibold text-cta uppercase" style="font-size:11px; letter-spacing:.16em; margin:0 0 20px;">
        PA20 — Display Personnel Record
      </p>
    </div>

    <!-- IDoc-style record card -->
    <div class="js-reveal border border-line bg-surface" style="--delay:60ms">

      <!-- Row 1: Document Type -->
      <div class="flex flex-wrap items-center border-b border-line px-5" style="gap:6px 20px; padding-top:18px; padding-bottom:18px;">
        <span class="font-display text-muted uppercase flex-shrink-0" style="font-size:11px; font-weight:600; letter-spacing:.1em; flex:0 0 9rem;">Document Type</span>
        <span class="font-display text-ink" style="font-size:15px; font-weight:600; flex:1 1 220px;">SAP Integration Engineer</span>
      </div>

      <!-- Row 2: Sender (name) -->
      <div class="flex flex-wrap items-center border-b border-line px-5" style="gap:6px 20px; padding-top:18px; padding-bottom:18px;">
        <span class="font-display text-muted uppercase flex-shrink-0" style="font-size:11px; font-weight:600; letter-spacing:.1em; flex:0 0 9rem;">Sender</span>
        <span class="font-display text-ink" style="font-size:clamp(1.5rem,3.4vw,2.25rem); font-weight:700; letter-spacing:-.01em; line-height:1.05; flex:1 1 220px;">Vijeth Pereira</span>
      </div>

      <!-- Row 3: Status -->
      <div class="flex flex-wrap items-center border-b border-line px-5" style="gap:6px 20px; padding-top:18px; padding-bottom:18px;">
        <span class="font-display text-muted uppercase flex-shrink-0" style="font-size:11px; font-weight:600; letter-spacing:.1em; flex:0 0 9rem;">Status</span>
        <span class="font-display text-ink" style="font-size:13px; line-height:1.6; flex:1 1 220px;">
          <span class="inline-block rounded-full bg-posted dot-pulse" style="width:7px; height:7px; margin-right:10px; vertical-align:middle;" aria-hidden="true"></span>
          53 &nbsp;·&nbsp; <span class="text-posted font-bold">POSTED</span> — actively building, open to new systems
        </span>
      </div>

      <!-- Row 4: Segments -->
      <div class="flex flex-wrap items-center px-5" style="gap:6px 20px; padding-top:18px; padding-bottom:18px;">
        <span class="font-display text-muted uppercase flex-shrink-0" style="font-size:11px; font-weight:600; letter-spacing:.1em; flex:0 0 9rem;">Segments</span>
        <span class="font-display text-ink" style="font-size:13px; flex:1 1 220px;">ABAP · EDI/B2B · IDOC &amp; ALE · OPENTEXT MIDDLEWARE</span>
      </div>

    </div>

    <!-- CTA buttons -->
    <div class="js-reveal flex flex-wrap items-center gap-4" style="--delay:140ms; margin-top:28px;">
      <a
        href="#work"
        class="font-display text-white bg-cta hover:opacity-90 transition-opacity duration-200 cursor-pointer btn-shimmer"
        style="font-size:11px; font-weight:700; text-transform:uppercase; letter-spacing:.12em; padding:14px 26px;"
      >
        View Work
      </a>
      <a
        href="/resume.pdf"
        target="_blank"
        rel="noopener"
        class="font-display text-ink border-2 border-ink hover:bg-ink hover:text-paper active:scale-[0.98] transition-all duration-200 cursor-pointer"
        style="font-size:11px; font-weight:700; text-transform:uppercase; letter-spacing:.12em; padding:12px 24px;"
      >
        Download Resume
      </a>
      <a
        href="#contact"
        class="font-display text-muted hover:text-ink transition-colors duration-200 cursor-pointer underline underline-offset-4"
        style="font-size:12px;"
      >
        Get in Touch →
      </a>
    </div>

    <!-- Meta strip -->
    <div class="js-reveal border-t border-line" style="--delay:220ms; margin-top:32px; padding-top:24px;">
      <p class="font-body text-muted" style="font-size:12px; line-height:1.7; margin:0;">
        <span class="font-display font-semibold text-ink">5+ Years</span> EDI &amp; SAP Integration
        &nbsp;·&nbsp;
        <span class="font-display font-semibold text-ink">Bengaluru, India</span>
        &nbsp;·&nbsp;
        Remote-ready
        &nbsp;·&nbsp;
        <span class="text-posted font-semibold">Open to new roles</span>
      </p>
    </div>

  </div>

  <!-- Right: Photo -->
  <div class="js-reveal-scale hidden lg:block" style="--delay:120ms; flex:0 1 300px; min-width:200px;">
    <div
      id="photo-float"
      style="position:relative; will-change:transform; transition:transform .25s cubic-bezier(.25,.46,.45,.94);"
    >
      <div class="absolute bg-cta" style="inset:-10px; opacity:.08; z-index:-1;"></div>
      <div class="border border-line overflow-hidden">
        <Image
          src={vijeth}
          alt="Vijeth Pereira — Senior Integration Engineer"
          class="w-full object-cover object-top"
          style="aspect-ratio:3/4; display:block;"
          loading="eager"
          width="352"
          height="469"
        />
      </div>
    </div>
  </div>

  <!-- Mobile photo -->
  <div class="js-reveal-scale lg:hidden flex justify-center" style="--delay:280ms; width:100%;">
    <div class="relative" style="width:128px;">
      <div class="absolute bg-cta" style="inset:-6px; opacity:.08; z-index:-1;"></div>
      <div class="border border-line overflow-hidden">
        <Image
          src={vijeth}
          alt="Vijeth Pereira"
          class="w-full h-full object-cover object-top"
          loading="eager"
          width="128"
          height="160"
        />
      </div>
    </div>
  </div>

</section>

<script is:inline>
  (function () {
    var hero  = document.getElementById("hero-section");
    var photo = document.getElementById("photo-float");
    if (!hero || !photo) return;

    hero.addEventListener("mousemove", function (e) {
      var r  = hero.getBoundingClientRect();
      var nx = (e.clientX - r.left - r.width  / 2) / (r.width  / 2);
      var ny = (e.clientY - r.top  - r.height / 2) / (r.height / 2);
      photo.style.transform = "translate(" + (nx * 28).toFixed(1) + "px, " + (ny * 16).toFixed(1) + "px)";
    });

    hero.addEventListener("mouseleave", function () {
      photo.style.transform = "translate(0px, 0px)";
    });
  })();
</script>
