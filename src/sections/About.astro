---
import SectionHeading from "../components/SectionHeading.astro";
import Badge from "../components/Badge.astro";

const certs = [
  "SAP Supply Chain: Learn EDI & IDocs Interface Architecture",
  "SAP Debugging for Functional Consultants",
  "Greenfield Training Program on SAP ABAP",
  "Thriving Together",
];
---

<section id="about" class="border-t border-line px-6" style="padding-top:clamp(48px,7vw,88px); padding-bottom:clamp(48px,7vw,88px);">
  <div class="max-w-content mx-auto">

    <div class="js-reveal">
      <SectionHeading segment="SEGMENT 01 — WE20 · Partner Profile" title="About" number="01" />
    </div>

    <div class="flex flex-wrap gap-10 lg:gap-14 items-start" style="gap:clamp(32px,5vw,56px);">

      <!-- Narrative -->
      <div class="js-reveal flex flex-col gap-5 font-body text-ink" style="--delay:80ms; flex:2 1 420px; min-width:0; font-size:15px; line-height:1.75;">
        <p style="margin:0;">
          I'm Vijeth Pereira — a Senior Integration Engineer at Henkel, based in Bengaluru, India.
          I work in the DXV/EDI Customer Integrations Hub (GTC), keeping Henkel's B2B EDI
          integrations running reliably across a global trading partner network.
        </p>
        <p style="margin:0;">
          With over 5 years in the consumer goods, retail, and manufacturing sectors, I specialise
          in EDI integration support — X12/ANSI, EDIFACT, VDA — across SAP IDocs, ALE, and
          middleware platforms (OpenText GXS, Seeburger B2B, GIB). My day-to-day is monitoring
          document flows, diagnosing failures fast, and making sure the right business teams get
          accurate information before errors become disruptions.
        </p>
        <p style="margin:0;">
          On the technical side I implement mapping changes per customer and business specifications,
          fix recurring error patterns at the root cause, and resolve SAP IDoc and EDI technical
          issues — from partner profile configurations to ABAP user exits. My collaborative approach
          spans business teams, customers, IT, and logistics service providers across WE, CEE, NA,
          LA, and APAC.
        </p>
        <p class="font-display text-muted uppercase" style="font-size:11px; letter-spacing:.08em; margin:8px 0 0;">
          Bengaluru / Mangaluru, India &nbsp;·&nbsp; Remote &nbsp;·&nbsp; English · Kannada · Konkani · Hindi
        </p>
      </div>

      <!-- Recognition + Certifications -->
      <div class="js-reveal flex flex-col gap-7" style="--delay:140ms; flex:1 1 260px; min-width:240px;">

        <div>
          <p class="font-display font-semibold text-cta uppercase" style="font-size:11px; letter-spacing:.12em; margin:0 0 14px;">Recognition</p>
          <div class="flex flex-col gap-2">
            <Badge label="Sieger Award" sublabel="Delivery Champion · Accenture" />
            <Badge label="Recognition Award" sublabel="Zero-escalation resolution, NA shift coverage · Accenture" />
            <Badge label="Multiple Client Appreciations" sublabel="Complex issue resolution, minimal business impact · Accenture, WE/NA/APAC clients" />
          </div>
        </div>

        <div>
          <p class="font-display font-semibold text-cta uppercase" style="font-size:11px; letter-spacing:.12em; margin:0 0 14px;">Certifications</p>
          <div class="flex flex-col gap-2">
            {certs.map((cert) => (
              <div class="border border-line bg-surface px-4 py-3 hover:border-posted transition-colors duration-200">
                <p class="font-body text-ink" style="font-size:12px; line-height:1.5; margin:0;">{cert}</p>
              </div>
            ))}
          </div>
        </div>

      </div>
    </div>

  </div>
</section>
