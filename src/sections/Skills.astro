---
import SectionHeading from "../components/SectionHeading.astro";
import SkillTag from "../components/SkillTag.astro";

const groups = [
  {
    title: "IDoc & ALE",
    featured: true,
    skills: [
      { label: "SAP ALE", status: "posted" as const },
      { label: "IDoc Monitoring & Reprocessing", status: "posted" as const },
      { label: "IDoc Error Resolution", status: "posted" as const },
      { label: "Partner Profiles & Ports", status: "posted" as const },
      { label: "RFC Destinations", status: "posted" as const },
      { label: "WE20 / WE02 / WE19", status: "posted" as const },
    ],
  },
  {
    title: "ABAP Development",
    featured: true,
    skills: [
      { label: "ABAP Debugging", status: "posted" as const },
      { label: "EDI User Exits", status: "posted" as const },
      { label: "Enhancement CRs", status: "posted" as const },
      { label: "VOE2 / VOE4 / NACE", status: "posted" as const },
      { label: "SAP ABAP (Deepening)", status: "pending" as const },
    ],
  },
  {
    title: "SAP Modules",
    featured: true,
    skills: [
      { label: "SD — Sales & Distribution", status: "posted" as const },
      { label: "LE — Logistics Execution", status: "posted" as const },
      { label: "MM — Materials Management", status: "posted" as const },
      { label: "OTC Process", status: "posted" as const },
    ],
  },
  {
    title: "EDI Standards",
    featured: false,
    skills: [
      { label: "ANSI X12", status: "posted" as const },
      { label: "EDIFACT", status: "posted" as const },
      { label: "VDA", status: "posted" as const },
      { label: "XML", status: "posted" as const },
    ],
  },
  {
    title: "Middleware & Connectivity",
    featured: false,
    skills: [
      { label: "OpenText GXS (TGMS)", status: "posted" as const },
      { label: "Seeburger B2B", status: "posted" as const },
      { label: "GIB", status: "posted" as const },
      { label: "RFC / FTP / SFTP", status: "posted" as const },
      { label: "VANs / WANs", status: "posted" as const },
      { label: "SAP CPI", status: "pending" as const },
    ],
  },
  {
    title: "Tools",
    featured: false,
    skills: [
      { label: "ServiceNow", status: "posted" as const },
      { label: "SAP Job Scheduling (SM37)", status: "posted" as const },
    ],
  },
  {
    title: "Languages",
    featured: false,
    skills: [
      { label: "English", status: "posted" as const },
      { label: "Kannada", status: "posted" as const },
      { label: "Hindi", status: "posted" as const },
      { label: "Konkani", status: "posted" as const },
      { label: "German (A1→A2)", status: "pending" as const },
    ],
  },
];

const featured = groups.filter(g => g.featured);
const rest     = groups.filter(g => !g.featured);
---

<section id="skills" class="border-t border-line px-6" style="padding-top:clamp(48px,7vw,88px); padding-bottom:clamp(48px,7vw,88px);">
  <div class="max-w-content mx-auto">

    <div class="js-reveal">
      <SectionHeading segment="SEGMENT 02 — BD10 · Master Data" title="Skills" number="02" />
    </div>

    <!-- Legend -->
    <div class="flex items-center gap-6" style="margin-bottom:32px;">
      <span class="inline-flex items-center gap-2 font-display text-muted uppercase" style="font-size:11px; font-weight:500; letter-spacing:.1em;">
        <span class="rounded-full bg-posted" style="width:7px; height:7px;" aria-hidden="true"></span>Active
      </span>
      <span class="inline-flex items-center gap-2 font-display text-muted uppercase" style="font-size:11px; font-weight:500; letter-spacing:.1em;">
        <span class="rounded-full bg-pending" style="width:7px; height:7px;" aria-hidden="true"></span>Developing
      </span>
    </div>

    <!-- Featured bento grid -->
    <div class="js-reveal grid gap-4" style="--delay:80ms; grid-template-columns:repeat(auto-fit,minmax(260px,1fr)); margin-bottom:16px;">
      {featured.map((group) => (
        <div class="border border-line bg-surface hover:border-cta transition-colors duration-300" style="padding:24px;">
          <p class="font-display font-semibold text-cta uppercase" style="font-size:11px; letter-spacing:.12em; margin:0 0 16px;">{group.title}</p>
          <div class="flex flex-wrap gap-2">
            {group.skills.map((s) => (
              <SkillTag label={s.label} status={s.status} />
            ))}
          </div>
        </div>
      ))}
    </div>

    <!-- Secondary groups -->
    <div class="js-reveal flex flex-col gap-6 border-t border-line" style="--delay:140ms; padding-top:24px;">
      {rest.map((group) => (
        <div>
          <p class="font-display text-muted uppercase" style="font-size:11px; font-weight:500; letter-spacing:.1em; margin:0 0 10px;">{group.title}</p>
          <div class="flex flex-wrap gap-2">
            {group.skills.map((s) => (
              <SkillTag label={s.label} status={s.status} />
            ))}
          </div>
        </div>
      ))}
    </div>

  </div>
</section>
