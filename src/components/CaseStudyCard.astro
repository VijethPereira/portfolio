---
import type { CollectionEntry } from "astro:content";

interface Props {
  entry: CollectionEntry<"work">;
}

const { entry } = Astro.props;
const { title, challenge, approach, outcome, status } = entry.data;
---

<article
  class="border border-line bg-surface flex flex-col hover:border-cta hover:-translate-y-1 hover:shadow-[0_16px_40px_rgba(0,0,0,0.10)] transition-[border-color,transform,box-shadow] duration-300"
>
  <!-- Status bar -->
  <div class="flex items-center gap-2 border-b border-line" style="padding:18px 22px;">
    <span
      class:list={[
        "rounded-full flex-shrink-0",
        status === "posted" ? "bg-posted" : "bg-pending",
      ]}
      style="width:7px; height:7px;"
      aria-hidden="true"
    />
    <span class="font-display text-muted uppercase" style="font-size:11px; font-weight:500; letter-spacing:.1em;">
      {status}
    </span>
  </div>

  <!-- Body -->
  <div class="flex flex-col flex-1" style="padding:22px; gap:16px;">
    <h3 class="font-display font-bold text-ink" style="font-size:14px; margin:0; line-height:1.4;">
      {title}
    </h3>

    <div>
      <p class="font-display font-semibold text-muted uppercase" style="font-size:10px; letter-spacing:.12em; margin:0 0 6px;">Challenge</p>
      <p class="font-body text-ink" style="font-size:13.5px; line-height:1.6; margin:0;">{challenge}</p>
    </div>
    <div>
      <p class="font-display font-semibold text-muted uppercase" style="font-size:10px; letter-spacing:.12em; margin:0 0 6px;">Approach</p>
      <p class="font-body text-ink" style="font-size:13.5px; line-height:1.6; margin:0;">{approach}</p>
    </div>
    <div>
      <p class="font-display font-semibold text-muted uppercase" style="font-size:10px; letter-spacing:.12em; margin:0 0 6px;">Outcome</p>
      <p class="font-body text-posted font-semibold" style="font-size:13.5px; line-height:1.6; margin:0;">{outcome}</p>
    </div>
  </div>
</article>
