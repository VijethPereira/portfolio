---
interface Props {
  segment: string;
  title: string;
  number?: string;
}

const { segment, title, number } = Astro.props;
---

<div class="flex items-baseline justify-between gap-4 flex-wrap" style="margin-bottom:clamp(28px,4vw,48px);">
  <div>
    <p class="font-display font-semibold text-cta uppercase" style="font-size:11px; letter-spacing:.16em; margin:0 0 10px;">{segment}</p>
    <h2 class="font-display font-bold text-ink" style="font-size:clamp(1.6rem,3vw,2.1rem); letter-spacing:-.01em; margin:0; line-height:1.15;">{title}</h2>
  </div>
  {number && (
    <span class="font-display font-bold text-ink select-none" style={`font-size:clamp(2.5rem,6vw,3.75rem); opacity:.06; line-height:1;`} aria-hidden="true">{number}</span>
  )}
</div>
