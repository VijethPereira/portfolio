---
interface Props {
  label: string;
  sublabel?: string;
}
const { label, sublabel } = Astro.props;
---

<div class="border border-line bg-surface flex gap-3 items-start" style="padding:12px 14px;">
  <span class="text-posted flex-shrink-0" style="font-size:13px; margin-top:1px;" aria-hidden="true">★</span>
  <div>
    <p class="font-display font-semibold text-ink uppercase" style="font-size:12px; letter-spacing:.04em; margin:0;">{label}</p>
    {sublabel && <p class="font-body text-muted" style="font-size:12px; margin:3px 0 0; line-height:1.5;">{sublabel}</p>}
  </div>
</div>
