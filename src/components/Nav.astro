---
const links = [
  { href: "#work",       label: "Work"       },
  { href: "#about",      label: "About"      },
  { href: "#skills",     label: "Skills"     },
  { href: "#experience", label: "Experience" },
  { href: "#contact",    label: "Contact"    },
];
---

<header class="sticky top-0 z-[100] bg-paper border-b border-line" style="backdrop-filter:blur(6px);">
  <nav
    class="max-w-content mx-auto px-6 flex items-center justify-between gap-4"
    style="height:64px;"
    aria-label="Site navigation"
  >

    <!-- Wordmark -->
    <a
      href="#hero"
      class="font-display text-sm font-bold text-ink hover:text-cta transition-colors duration-200 cursor-pointer"
      style="letter-spacing:.04em;"
    >
      VIJETH PEREIRA
    </a>

    <!-- Desktop links -->
    <div class="hidden md:flex items-center gap-7 flex-wrap justify-end">
      {links.map(({ href, label }) => (
        <a
          href={href}
          data-nav-link
          class="font-display text-muted hover:text-ink transition-colors duration-200 cursor-pointer"
          style="font-size:11px; font-weight:500; text-transform:uppercase; letter-spacing:.12em;"
        >
          {label}
        </a>
      ))}

      <!-- Theme toggle -->
      <button
        id="theme-toggle"
        class="border border-line rounded-full inline-flex items-center justify-center text-muted hover:text-ink hover:border-cta transition-all duration-200 cursor-pointer"
        style="width:32px; height:32px;"
        aria-label="Switch to dark mode"
      >
        <svg id="icon-moon" xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true">
          <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/>
        </svg>
        <svg id="icon-sun" xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true" class="hidden">
          <circle cx="12" cy="12" r="5"/><line x1="12" y1="1" x2="12" y2="3"/><line x1="12" y1="21" x2="12" y2="23"/>
          <line x1="4.2" y1="4.2" x2="5.6" y2="5.6"/><line x1="18.4" y1="18.4" x2="19.8" y2="19.8"/>
          <line x1="1" y1="12" x2="3" y2="12"/><line x1="21" y1="12" x2="23" y2="12"/>
          <line x1="4.2" y1="19.8" x2="5.6" y2="18.4"/><line x1="18.4" y1="5.6" x2="19.8" y2="4.2"/>
        </svg>
      </button>

      <!-- Resume CTA -->
      <a
        href="/resume.pdf"
        target="_blank"
        rel="noopener"
        class="font-display text-white bg-cta hover:opacity-90 transition-opacity duration-200 cursor-pointer"
        style="font-size:11px; font-weight:700; text-transform:uppercase; letter-spacing:.1em; padding:9px 16px;"
      >
        Resume
      </a>
    </div>

    <!-- Mobile controls -->
    <div class="flex md:hidden items-center gap-3">
      <button
        id="theme-toggle-mobile"
        class="border border-line rounded-full inline-flex items-center justify-center text-muted hover:text-ink hover:border-cta transition-all duration-200 cursor-pointer"
        style="width:32px; height:32px;"
        aria-label="Switch to dark mode"
      >
        <svg id="icon-moon-mobile" xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true">
          <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/>
        </svg>
        <svg id="icon-sun-mobile" xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true" class="hidden">
          <circle cx="12" cy="12" r="5"/><line x1="12" y1="1" x2="12" y2="3"/><line x1="12" y1="21" x2="12" y2="23"/>
          <line x1="4.2" y1="4.2" x2="5.6" y2="5.6"/><line x1="18.4" y1="18.4" x2="19.8" y2="19.8"/>
          <line x1="1" y1="12" x2="3" y2="12"/><line x1="21" y1="12" x2="23" y2="12"/>
          <line x1="4.2" y1="19.8" x2="5.6" y2="18.4"/><line x1="18.4" y1="5.6" x2="19.8" y2="4.2"/>
        </svg>
      </button>
      <button
        id="nav-toggle"
        class="font-display text-xs font-medium uppercase tracking-widest text-muted hover:text-ink transition-colors duration-200 cursor-pointer"
        aria-expanded="false"
        aria-controls="mobile-menu"
        aria-label="Toggle navigation"
      >
        Menu
      </button>
    </div>

  </nav>

  <!-- Mobile menu -->
  <div id="mobile-menu" class="hidden md:hidden bg-paper border-t border-line px-6 pb-6">
    <div class="flex flex-col gap-5 pt-5">
      {links.map(({ href, label }) => (
        <a
          href={href}
          class="font-display text-sm font-medium uppercase tracking-widest text-muted hover:text-ink transition-colors duration-200 cursor-pointer"
        >
          {label}
        </a>
      ))}
      <div class="pt-2">
        <a
          href="/resume.pdf"
          target="_blank"
          rel="noopener"
          class="font-display text-sm font-bold uppercase tracking-widest bg-cta text-white px-5 py-2.5 inline-block hover:opacity-90 transition-opacity duration-200 cursor-pointer"
        >
          Resume
        </a>
      </div>
    </div>
  </div>
</header>

<script>
  const navToggle = document.getElementById("nav-toggle");
  const menu      = document.getElementById("mobile-menu");

  navToggle?.addEventListener("click", () => {
    const open = navToggle.getAttribute("aria-expanded") === "true";
    navToggle.setAttribute("aria-expanded", String(!open));
    if (!open) {
      menu?.classList.remove("hidden");
      menu?.classList.remove("menu-slide");
      void (menu as HTMLElement | null)?.offsetHeight;
      menu?.classList.add("menu-slide");
    } else {
      menu?.classList.add("hidden");
    }
  });

  menu?.querySelectorAll("a").forEach((a) =>
    a.addEventListener("click", () => {
      menu.classList.add("hidden");
      navToggle?.setAttribute("aria-expanded", "false");
    })
  );

  const moonD = document.getElementById("icon-moon");
  const sunD  = document.getElementById("icon-sun");
  const moonM = document.getElementById("icon-moon-mobile");
  const sunM  = document.getElementById("icon-sun-mobile");
  const btnD  = document.getElementById("theme-toggle");
  const btnM  = document.getElementById("theme-toggle-mobile");

  function syncIcons(isDark: boolean) {
    moonD?.classList.toggle("hidden", isDark);
    sunD?.classList.toggle("hidden", !isDark);
    moonM?.classList.toggle("hidden", isDark);
    sunM?.classList.toggle("hidden", !isDark);
    const label = isDark ? "Switch to light mode" : "Switch to dark mode";
    btnD?.setAttribute("aria-label", label);
    btnM?.setAttribute("aria-label", label);
  }

  function applyTheme(dark: boolean) {
    document.documentElement.classList.toggle("dark", dark);
    localStorage.setItem("theme", dark ? "dark" : "light");
    syncIcons(dark);
  }

  syncIcons(document.documentElement.classList.contains("dark"));
  btnD?.addEventListener("click", () => applyTheme(!document.documentElement.classList.contains("dark")));
  btnM?.addEventListener("click", () => applyTheme(!document.documentElement.classList.contains("dark")));
</script>
